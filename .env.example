# All of these are optional — every field has a working default (see
# src/config.rs) and this file is loaded best-effort at startup via
# `dotenvy`. Copy to `.env` and fill in only what you need. Never commit a
# real `.env` (it's in .gitignore).

# ── Ports ────────────────────────────────────────────────────────────────
# GATEWAY_PORT=8080
# AGENT_PORT=8090
# GITHUB_MOCK_PORT=8081
# NOTION_MOCK_PORT=8082

# ── Storage / policy ─────────────────────────────────────────────────────
# DATABASE_URL=sqlite://./hitl_poc.db
# POLICY_PATH=policy.toml

# ── Composio (optional — only needed for the live Composio demo) ─────────
# Leave both unset to run with the two mock connectors only (this is what
# `cargo test` and a plain `cargo run` do). Set both to register one real,
# Composio-backed connector alongside the mocks — see gateway/composio.rs
# and DEMO_GUIDE.md's "Composio demo" section.
#
# COMPOSIO_API_KEY: from your Composio dashboard.
# COMPOSIO_AUTH_CONFIG_ID: id of an auth config for the toolkit you pick
#   (create one in the Composio dashboard, or via
#   `curl -s https://backend.composio.dev/api/v3/auth_configs \
#      -H "x-api-key: $COMPOSIO_API_KEY" -H "content-type: application/json" \
#      -d '{"toolkit": {"slug": "github"}, "auth_config": {"type": "use_composio_managed_auth"}}'`).
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=

# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_CONNECTOR_NAME=composio_github
# COMPOSIO_SERVER_NAME=mcp-gateway-hitl-poc-demo
# COMPOSIO_ALLOWED_TOOLS=GITHUB_LIST_REPOSITORIES_FOR_THE_AUTHENTICATED_USER,GITHUB_CREATE_AN_ISSUE
#   ^ verify these slugs are actually enabled on your auth config's toolkit
#     in the Composio dashboard — override if your toolkit uses different
#     ones. Whichever "ask"-worthy tool you pick, add a matching rule to
#     policy.toml under COMPOSIO_CONNECTOR_NAME.
#
# No OAuth callback/redirect URL variable exists here on purpose: the
# `use_composio_managed_auth` auth config created above uses Composio's own
# already-registered OAuth app and callback
# (`https://backend.composio.dev/api/v1/auth-apps/add`) — this POC never
# runs a callback listener of its own. A callback URL only becomes this
# repo's concern if you switch to a *custom* auth config (your own
# registered GitHub OAuth App), which is a deliberate choice this POC
# doesn't make.

# OPENAI_API_KEY is intentionally not used by this POC: the agent's
# `/agent/act` endpoint takes an already-decided (connector, tool_name,
# arguments) task rather than natural language, so no LLM call sits in the
# HITL decision path — see README.md's "Why no LLM" note.
